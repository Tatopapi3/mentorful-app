// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
}

enum Domain {
  CLASSROOM
  PLANNING
  COMMUNICATION
  ASSESSMENT
}

enum PairingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VisitRecordStatus {
  DRAFT
  SUBMITTED
}

model School {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())

  users     UserProfile[]
  cycles    Cycle[]
  pairings  Pairing[]
  visits    VisitRecord[]
}

model UserProfile {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  schoolId    String
  role        Role
  name        String
  email       String
  department  String?

  strengthTags    Json?
  personalityTags Json?
  funTags         Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id])

  hostPairings    Pairing[]     @relation("HostPairings")
  visitorPairings Pairing[]     @relation("VisitorPairings")
  hostVisits      VisitRecord[] @relation("HostVisits")
  visitorVisits   VisitRecord[] @relation("VisitorVisits")

  @@index([schoolId])
}

model Cycle {
  id               String   @id @default(cuid())
  schoolId         String
  name             String
  startDate        DateTime
  endDate          DateTime
  strategicPriority String

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school           School   @relation(fields: [schoolId], references: [id])
  pairings         Pairing[]
  visits           VisitRecord[]

  @@index([schoolId])
}

model Pairing {
  id          String       @id @default(cuid())
  schoolId    String
  cycleId     String
  hostId      String
  visitorId   String

  domain      Domain
  strategicTag String
  status      PairingStatus @default(PENDING)

  createdAt   DateTime     @default(now())
  approvedAt  DateTime?

  school      School       @relation(fields: [schoolId], references: [id])
  cycle       Cycle        @relation(fields: [cycleId], references: [id])

  host        UserProfile  @relation("HostPairings", fields: [hostId], references: [id])
  visitor     UserProfile  @relation("VisitorPairings", fields: [visitorId], references: [id])

  visit       VisitRecord?

  @@index([schoolId])
  @@index([cycleId])
  @@index([hostId])
  @@index([visitorId])

  // Prevent duplicate pairings for same pair in same cycle (order-specific)
  @@unique([cycleId, hostId, visitorId])
}

model VisitRecord {
  id            String           @id @default(cuid())
  schoolId      String
  cycleId       String
  pairingId     String           @unique

  hostId        String
  visitorId     String

  domain        Domain
  strategicTag  String

  visionText    String?
  strengthsText String?
  moreText      String?
  lessText      String?
  supportText   String?
  strengthTags  Json?

  status        VisitRecordStatus @default(DRAFT)
  submittedAt   DateTime?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  school        School            @relation(fields: [schoolId], references: [id])
  cycle         Cycle             @relation(fields: [cycleId], references: [id])
  pairing       Pairing           @relation(fields: [pairingId], references: [id])

  host          UserProfile       @relation("HostVisits", fields: [hostId], references: [id])
  visitor       UserProfile       @relation("VisitorVisits", fields: [visitorId], references: [id])

  @@index([schoolId])
  @@index([cycleId])
  @@index([hostId])
  @@index([visitorId])
}

