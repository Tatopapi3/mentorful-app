{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "synthetic": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-synthetic-culture-scan.ts",
    "synthetic:dry": "npm run synthetic -- --dry-run",
    "synthetic:clean": "npm run synthetic -- --clean",
    "synthetic:stats": "npm run synthetic -- --stats-only",
    "items": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-culture-scan-items.ts",
    "items:dry": "npm run items -- --dry-run",
    "items:verify": "npm run items -- --verify",
    "preview:nick": "PREVIEW_DATASET=nick NEXT_PUBLIC_CULTURE_SCAN_SURVEY_ID=ec3b0a3a-1e4b-4f47-bc50-de5b2832e60f NEXT_PUBLIC_CULTURE_SCAN_SCHOOL_ID=a0000000-0000-0000-0000-000000000001 npm run preview",
    "preview": "PREVIEW_MOCK=1 NEXT_PUBLIC_PREVIEW_MOCK=1 NEXT_PUBLIC_SUPABASE_URL=https://preview.invalid NEXT_PUBLIC_SUPABASE_ANON_KEY=preview NEXT_PUBLIC_CULTURE_SCAN_SURVEY_ID=${NEXT_PUBLIC_CULTURE_SCAN_SURVEY_ID:-preview-survey} NEXT_PUBLIC_CULTURE_SCAN_SCHOOL_ID=${NEXT_PUBLIC_CULTURE_SCAN_SCHOOL_ID:-school-sandbox} SUPABASE_SERVICE_ROLE_KEY=preview next dev -p 3200",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.6",
    "d3-force": "^3.0.0",
    "jspdf": "^4.2.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
